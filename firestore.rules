rules_version = '2';

// Firestore security rules for Secure Chat.
// Message content is E2E-encrypted client-side; these rules enforce ACCESS
// (who can read/write which docs), not confidentiality of content.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isParticipant(chatId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    // Users: anyone signed in can read profiles (needed for search + public keys);
    // only the owner can write their own profile.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid);
      allow update, delete: if isSelf(uid);
    }

    // Chats: only participants can read; creation requires the creator to be a
    // participant; updates limited to participants.
    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      // Messages: only chat participants can read/write. Sender must be self.
      match /messages/{messageId} {
        allow read: if isParticipant(chatId);
        allow create: if isParticipant(chatId)
          && request.resource.data.senderUid == request.auth.uid;
        // Allow status updates (delivered/read) by any participant.
        allow update: if isParticipant(chatId);
        allow delete: if isParticipant(chatId)
          && resource.data.senderUid == request.auth.uid;
      }
    }
  }
}
